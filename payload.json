                \"services/wishlists.Service.ss\"\n            ]\n        }\n    },\n    \"configuration\": {\n        \"files\": [\n            \"Modules/wishlists/Configuration/wishlists.json\"\n        ]\n    },\n    \"templates\": {\n        \"application\": {\n            \"shopping\": {\n                \"files\": [\n                    \"Modules/wishlists/Templates/jj_wishlists_wishlists.tpl\",\n                    \"Modules/wishlists/Templates/jj_product_list_control.tpl\"\n                ]\n            },\n            \"myaccount\": {\n                \"files\": [\n                    \"Modules/wishlists/Templates/jj_wishlists_wishlists.tpl\",\n                    \"Modules/wishlists/Templates/jj_product_list_control.tpl\"\n                ]\n            },\n            \"checkout\": {\n                \"files\": [\n                    \"Modules/wishlists/Templates/jj_wishlists_wishlists.tpl\",\n                    \"Modules/wishlists/Templates/jj_product_list_control.tpl\"\n                ]\n            }\n        }\n    },\n    \"sass\": {\n        \"entry_points\": {\n            \"shopping\": \"Modules/wishlists/Sass/_wishlists-wishlists.scss\",\n            \"myaccount\": \"Modules/wishlists/Sass/_wishlists-wishlists.scss\",\n            \"checkout\": \"Modules/wishlists/Sass/_wishlists-wishlists.scss\"\n        },\n        \"files\": [\n            \"Modules/wishlists/Sass/_wishlists-wishlists.scss\"\n        ]\n    },\n    \"javascript\": {\n        \"entry_points\": {\n            \"shopping\": \"Modules/wishlists/JavaScript/JJ.wishlists.wishlists.js\",\n            \"myaccount\": \"Modules/wishlists/JavaScript/JJ.wishlists.wishlists.js\",\n            \"checkout\": \"Modules/wishlists/JavaScript/JJ.wishlists.wishlists.js\"\n        },\n        \"application\": {\n            \"shopping\": {\n                \"files\": [\n                    \"Modules/wishlists/JavaScript/JJ.wishlists.wishlists.js\",\n                    \"Modules/wishlists/JavaScript/wishlists.View.js\",\n                    \"Modules/wishlists/JavaScript/JJ.wishlists.wishlists.Model.js\",\n                    \"Modules/wishlists/JavaScript/JJ.wishlists.wishlists.SS2Model.js\"\n                ]\n            },\n            \"myaccount\": {\n                \"files\": [\n                    \"Modules/wishlists/JavaScript/JJ.wishlists.wishlists.js\",\n                    \"Modules/wishlists/JavaScript/wishlists.View.js\",\n                    \"Modules/wishlists/JavaScript/JJ.wishlists.wishlists.Model.js\",\n                    \"Modules/wishlists/JavaScript/JJ.wishlists.wishlists.SS2Model.js\"\n                ]\n            },\n            \"checkout\": {\n                \"files\": [\n                    \"Modules/wishlists/JavaScript/JJ.wishlists.wishlists.js\",\n                    \"Modules/wishlists/JavaScript/wishlists.View.js\",\n                    \"Modules/wishlists/JavaScript/JJ.wishlists.wishlists.Model.js\",\n                    \"Modules/wishlists/JavaScript/JJ.wishlists.wishlists.SS2Model.js\"\n                ]\n            }\n        }\n    },\n    \"ssp-libraries\": {\n        \"entry_point\": \"Modules/wishlists/SuiteScript/JJ.wishlists.wishlists.js\",\n        \"files\": [\n            \"Modules/wishlists/SuiteScript/JJ.wishlists.wishlists.js\",\n            \"Modules/wishlists/SuiteScript/wishlists.ServiceController.js\"\n        ]\n    },\n    \"suitescript2\": {\n        \"files\": [\n            \"Modules/wishlists/SuiteScript2/wishlists.Service.ss\"\n        ]\n    }\n}"},{"path":"\\JJ\\wishlists@1.0.0\\Modules\\wishlists\\Templates\\jj_wishlists_wishlists.tpl","type":"application/vnd.groove-tool-template","contents":"<div class=\"wishlist-integrated-container\" style=\"position: relative; display: inline-block; width: 100%; text-align: center;\">\n    {{!-- 1. THE VISUAL HEART ICON --}}\n<button class=\"wishlist-icon-btn\" \n            data-action=\"toggle-wishlist\" \n            style=\"background: none !important; border: none !important; cursor: pointer !important; font-size: 32px !important; color: #e74c3c !important; outline: none !important;\"\n            title=\"{{#if inWishlist}}Remove from Wishlist{{else}}Add to Wishlist{{/if}}\">\n<span class=\"heart-symbol\" style=\"transition: transform 0.2s ease;\">\n            {{#if inWishlist}}❤{{else}}♡{{/if}}\n</span>\n</button>\n \n    {{!-- 2. THE NATIVE TRIGGER (Hidden but functional) --}}\n<div class=\"native-wishlist-trigger-wrapper\" style=\"display: none !important;\">\n        {{#if isMoving}}\n<button class=\"product-list-control-button-move\" data-action=\"show-productlist-control\" data-toggle=\"showFlyout\" type=\"button\">\n                {{translate 'Move'}}\n</button>\n        {{else}}\n<button class=\"product-list-control-button-wishlist\" data-action=\"show-productlist-control\" data-toggle=\"showFlyout\" type=\"button\" >\n                {{translate 'Add to Wishlist'}}\n</button>\n        {{/if}}\n</div>\n \n    {{!-- 3. THE FLYOUT / DROPDOWN CONTAINER --}}\n<div class=\"wishlist-dropdown-container\" \n         style=\"position: absolute; top: 100%; left: 50%; transform: translateX(-50%); z-index: 10000; background: white; {{#if showMenu}}display: block !important;{{else}}display: none !important;{{/if}}\">\n    <div data-view=\"ProductListControl\"></div>\n</div>\n \n</div>"}]}